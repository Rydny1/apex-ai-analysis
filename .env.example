ANTHROPIC_API_KEY=
# From dashboard.api-football.com (the direct API-Sports gateway) - NOT a
# RapidAPI key, those are two separate auth systems for the same data.
API_FOOTBALL_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Optional fallback sources - leave blank if unused
FOOTBALL_DATA_ORG_KEY=
ODDS_API_KEY=

# The one account allowed to trigger real (costed) runs - see lib/auth-role.ts.
# Every other signed-in account is a guest and only sees demo data.
ADMIN_EMAIL=

# Legacy single-user allowlist, no longer read by proxy.ts - kept only if
# other tooling still references it.
APEX_OWNER_EMAIL=

# Shared secret Vercel Cron sends as a Bearer token to /api/cron/settle
CRON_SECRET=
